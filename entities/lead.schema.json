{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/lead.schema.json",
  "title": "Lead",
  "description": "CRM Lead/Potential customer management schema for dental clinic",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Full name of the potential customer",
      "minLength": 1,
      "maxLength": 255
    },
    "phone": {
      "type": "string",
      "title": "Phone",
      "description": "Primary contact phone number",
      "pattern": "^[+]?[0-9\\s\\-\\(\\)]{7,20}$"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email",
      "description": "Email address of the lead",
      "maxLength": 255
    },
    "visit_date": {
      "type": "string",
      "format": "date",
      "title": "Visit Date",
      "description": "Scheduled or actual visit date (YYYY-MM-DD)"
    },
    "visit_time": {
      "type": "string",
      "title": "Visit Time",
      "description": "Scheduled visit time",
      "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
    },
    "source": {
      "type": "string",
      "title": "Source",
      "description": "Marketing channel where lead was acquired",
      "enum": [
        "Telegram",
        "Instagram",
        "Facebook",
        "Website",
        "Google Ads",
        "Referral",
        "Walk-in",
        "Call",
        "Email",
        "SMS",
        "Other"
      ]
    },
    "source_detail": {
      "type": "string",
      "title": "Source Detail",
      "description": "Additional details about the source (e.g., referrer name, campaign ID)",
      "maxLength": 500
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Current status in the sales pipeline",
      "enum": [
        "New",
        "Contacted",
        "Qualified",
        "Interested",
        "Appointment Scheduled",
        "Visited",
        "Proposal Sent",
        "Negotiating",
        "Converted",
        "Lost",
        "On Hold"
      ],
      "default": "New"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "description": "Lead priority level",
      "enum": ["Low", "Medium", "High", "Urgent"],
      "default": "Medium"
    },
    "service_interest": {
      "type": "array",
      "title": "Service Interest",
      "description": "Services the lead is interested in",
      "items": {
        "type": "string",
        "enum": [
          "Implant",
          "Crown",
          "Bridge",
          "Whitening",
          "Cleaning",
          "Orthodontics",
          "Root Canal",
          "Extraction",
          "Veneers",
          "Dentures",
          "Consultation",
          "Other"
        ]
      }
    },
    "budget_estimate": {
      "type": "number",
      "title": "Budget Estimate",
      "description": "Estimated budget or quoted price",
      "minimum": 0
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To",
      "description": "Staff member responsible for this lead",
      "maxLength": 255
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "General notes about the lead",
      "maxLength": 2000
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "title": "Follow-up Date",
      "description": "Next scheduled follow-up date"
    },
    "follow_up_reminder": {
      "type": "boolean",
      "title": "Follow-up Reminder",
      "description": "Whether to send follow-up reminder",
      "default": false
    },
    "interaction_history": {
      "type": "array",
      "title": "Interaction History",
      "description": "History of all communications with the lead",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Interaction timestamp"
          },
          "type": {
            "type": "string",
            "enum": ["Call", "SMS", "Email", "WhatsApp", "Telegram", "In-Person", "Other"],
            "description": "Type of interaction"
          },
          "direction": {
            "type": "string",
            "enum": ["Inbound", "Outbound"],
            "description": "Direction of communication"
          },
          "summary": {
            "type": "string",
            "description": "Summary of the interaction",
            "maxLength": 1000
          },
          "staff": {
            "type": "string",
            "description": "Staff member who handled the interaction",
            "maxLength": 100
          }
        },
        "required": ["date", "type"]
      }
    },
    "converted_to_patient_id": {
      "type": "string",
      "title": "Converted Patient ID",
      "description": "Patient ID if lead was converted to patient"
    },
    "converted_date": {
      "type": "string",
      "format": "date",
      "title": "Converted Date",
      "description": "Date when lead was converted to patient"
    },
    "is_active": {
      "type": "boolean",
      "title": "Is Active",
      "description": "Whether lead is still active",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At",
      "description": "Lead creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At",
      "description": "Last update timestamp"
    },
    "created_by": {
      "type": "string",
      "title": "Created By",
      "description": "User who created the lead",
      "maxLength": 100
    }
  },
  "required": ["name", "phone"],
  "additionalProperties": false
}
