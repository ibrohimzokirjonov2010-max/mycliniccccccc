{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/payment.schema.json",
  "title": "Payment",
  "description": "Financial transaction and payment management schema for dental clinic",
  "type": "object",
  "properties": {
    "payment_id": {
      "type": "string",
      "title": "Payment ID",
      "description": "Unique payment transaction identifier"
    },
    "patient_id": {
      "type": "string",
      "title": "Patient ID",
      "description": "Unique identifier of the patient"
    },
    "patient_name": {
      "type": "string",
      "title": "Patient Name",
      "description": "Full name of the patient",
      "minLength": 1,
      "maxLength": 255
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "Type of financial transaction",
      "enum": [
        "Income",
        "Debt",
        "Expense",
        "Refund",
        "Discount",
        "Insurance",
        "Deposit",
        "Adjustment"
      ]
    },
    "category": {
      "type": "string",
      "title": "Category",
      "description": "Detailed category of the transaction",
      "enum": [
        "Treatment",
        "Consultation",
        "Implant",
        "Crown",
        "Bridge",
        "Whitening",
        "Orthodontics",
        "Surgery",
        "X-Ray",
        "Lab Fee",
        "Material",
        "Equipment",
        "Salary",
        "Rent",
        "Utilities",
        "Marketing",
        "Other"
      ]
    },
    "amount": {
      "type": "number",
      "title": "Amount",
      "description": "Transaction amount in local currency",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "description": "Currency code (ISO 4217)",
      "default": "UZS",
      "maxLength": 3
    },
    "method": {
      "type": "string",
      "title": "Method",
      "description": "Payment method used",
      "enum": [
        "Cash",
        "Card",
        "Transfer",
        "Click",
        "Payme",
        "Uzum",
        "Humo",
        "Insurance",
        "Mixed",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Current status of the payment",
      "enum": [
        "Pending",
        "Completed",
        "Failed",
        "Cancelled",
        "Refunded",
        "Partially Refunded"
      ],
      "default": "Completed"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date",
      "description": "Transaction date (YYYY-MM-DD)"
    },
    "time": {
      "type": "string",
      "title": "Time",
      "description": "Transaction time",
      "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
    },
    "appointment_id": {
      "type": "string",
      "title": "Appointment ID",
      "description": "Related appointment ID"
    },
    "treatment_id": {
      "type": "string",
      "title": "Treatment ID",
      "description": "Related treatment/procedure ID"
    },
    "service_name": {
      "type": "string",
      "title": "Service Name",
      "description": "Name of the service provided",
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Detailed description of the transaction",
      "maxLength": 1000
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "Additional notes",
      "maxLength": 2000
    },
    "receipt_number": {
      "type": "string",
      "title": "Receipt Number",
      "description": "Official receipt or invoice number",
      "maxLength": 100
    },
    "is_taxable": {
      "type": "boolean",
      "title": "Is Taxable",
      "description": "Whether transaction is subject to tax",
      "default": true
    },
    "tax_amount": {
      "type": "number",
      "title": "Tax Amount",
      "description": "Tax amount applied",
      "default": 0,
      "minimum": 0
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount Amount",
      "description": "Discount applied to this transaction",
      "default": 0,
      "minimum": 0
    },
    "original_amount": {
      "type": "number",
      "title": "Original Amount",
      "description": "Amount before discount",
      "minimum": 0
    },
    "balance_before": {
      "type": "number",
      "title": "Balance Before",
      "description": "Patient balance before transaction"
    },
    "balance_after": {
      "type": "number",
      "title": "Balance After",
      "description": "Patient balance after transaction"
    },
    "split_payment": {
      "type": "array",
      "title": "Split Payment",
      "description": "Multiple payment methods for single transaction",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": ["Cash", "Card", "Transfer", "Click", "Payme", "Uzum", "Humo", "Insurance"],
            "description": "Payment method"
          },
          "amount": {
            "type": "number",
            "description": "Amount paid with this method",
            "minimum": 0
          }
        },
        "required": ["method", "amount"]
      }
    },
    "related_payment_id": {
      "type": "string",
      "title": "Related Payment ID",
      "description": "Original payment ID for refunds or adjustments"
    },
    "processed_by": {
      "type": "string",
      "title": "Processed By",
      "description": "Staff member who processed the payment",
      "maxLength": 100
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By",
      "description": "Staff member who approved the transaction",
      "maxLength": 100
    },
    "receipt_url": {
      "type": "string",
      "format": "uri",
      "title": "Receipt URL",
      "description": "URL to digital receipt"
    },
    "doctor_id": {
      "type": "string",
      "title": "Doctor ID",
      "description": "Unique identifier of the doctor who provided the service"
    },
    "doctor_name": {
      "type": "string",
      "title": "Doctor Name",
      "description": "Name of the doctor who provided the service",
      "maxLength": 255
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At",
      "description": "Record creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At",
      "description": "Last update timestamp"
    }
  },
  "required": ["patient_name", "type", "amount", "date"],
  "additionalProperties": false
}
