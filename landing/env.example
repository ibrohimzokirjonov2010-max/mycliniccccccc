# Public URL of the clinic CRM (Kirish + success page).
NEXT_PUBLIC_APP_URL=https://app-shahobidin-4.vercel.app

# Public URL of THIS landing deployment. Used for Payme/Click return links.
# Example: https://shifo-landing.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional label shown next to the app link in the footer.
NEXT_PUBLIC_APP_LABEL=app.shifo.uz

# HMAC secret for the success-page token. Required in production when
# Payme or Click keys are set. Demo mode (no merchant keys) uses a built-in secret.
LICENSE_SIGNING_SECRET=

# Payme Merchant API. Leave empty to use demo (mock) pay for Payme.
# Checkout: https://checkout.paycom.uz
# Webhook:  https://<landing-domain>/api/webhooks/payme
# Basic auth login is Paycom. Password is PAYME_SECRET_KEY.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_LOGIN=Paycom

# Click SHOP API. Leave empty to use demo (mock) pay for Click.
# Webhook prepare:  https://<landing-domain>/api/webhooks/click/prepare
# Webhook complete: https://<landing-domain>/api/webhooks/click/complete
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Persistent store for Vercel (serverless). Without this, orders live in
# landing/.data/store.json which is correct for `next dev` / `next start`,
# and ephemeral on Vercel. Mock pay still completes via a signed token.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the JSON store directory.
LANDING_DATA_DIR=

# CRM Super Admin database. Leave empty to use the Supabase project the
# portal already reads (public.clinics and public.users). Set DISABLED=1
# to keep licenses local and skip that write.
CRM_SUPABASE_URL=
CRM_SUPABASE_KEY=
CRM_SUPABASE_DISABLED=

# Bearer token for GET /api/admin/subscriptions. Server only.
LANDING_ADMIN_TOKEN=
